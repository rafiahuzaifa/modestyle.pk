# Database (use SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./modeststyle.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/modeststyle

# Sanity (read-only — used to verify product prices server-side at checkout)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-02-16

# AI Services (at least one required for chat)
GROK_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Frontend URL (for CORS + payment gateway redirects)
FRONTEND_URL=http://localhost:3000
